{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=UserAPI;Trusted_Connection=true;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_ENV_VAR_OR_USER_SECRETS",
    "Issuer": "UserAPI",
    "Audience": "UserAPIClient",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7245", "http://localhost:5245" ]
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowInSeconds": 60
  }
}
